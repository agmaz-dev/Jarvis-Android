<?xml version="1.0" encoding="utf-8"?>
<!-- Erlaubt http:// für Ollama auf dem Handy (localhost) oder im eigenen WLAN -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
